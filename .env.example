# Copy to .env and adjust. Never commit a real .env file.
# The SDWAN_* block is required — everything else has a working default.
#
# The server reads this file at startup (repository root, or SDWAN_ENV_FILE to
# point elsewhere). Variables already set in the environment — compose
# env_file, docker --env-file, Kubernetes secrets — always win over it.
# SDWAN_VMANAGE_URL takes precedence over SDWAN_VMANAGE_HOST/PORT: set one or
# the other, not both.

# ---------------------------------------------------------------------------
# Cisco Catalyst SD-WAN Manager (vManage) — REQUIRED
# ---------------------------------------------------------------------------
# Full URL of the controller, including the port when it is not 443.
SDWAN_VMANAGE_URL=https://vmanage.example.com:8443
# Alternative to the URL: host (+ optional port, default 443).
#SDWAN_VMANAGE_HOST=vmanage.example.com
#SDWAN_VMANAGE_PORT=8443

SDWAN_USERNAME=automation-readonly
SDWAN_PASSWORD=change-me

# TLS verification. Leave true in production. Many labs and on-box controllers
# present a self-signed certificate — prefer pointing at its CA over disabling
# verification entirely.
SDWAN_VERIFY_SSL=true
#SDWAN_CA_BUNDLE=/app/certificates/vmanage-ca.pem

# Seconds to wait for vManage. Real-time endpoints poll the device itself and
# can be slow on a large fabric.
SDWAN_TIMEOUT=60

# Default cap on records a single tool call returns, so one broad question
# cannot flood the model's context.
SDWAN_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Write protection
# ---------------------------------------------------------------------------
# false (default) — configuration-changing tools are NOT registered at all, so
#   the model cannot see or call them. The server is read-only.
# true            — attach_device_template, activate_vsmart_policy and
#   get_task_status are registered. Each still requires explicit user approval
#   (MCP elicitation, or confirm=True on clients that cannot prompt).
# Use a vManage account with only the privileges you intend to grant: this flag
# governs the tool surface, not what the account itself is allowed to do.
SDWAN_ENABLE_WRITES=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
MCP_SERVER_NAME=cisco-sdwan-mcp

# Transport: "http" (default — deployable, supports auth) or "stdio" (local
# subprocess for desktop clients; host/port/auth do not apply).
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Authentication of MCP clients to THIS server (HTTP transport only).
# Unrelated to SDWAN_USERNAME/SDWAN_PASSWORD, which authenticate this server to
# vManage. Pick ONE mode.
# Modes: none | static | jwt | introspection | oauth-proxy |
#        github | google | azure | auth0 | workos
# ---------------------------------------------------------------------------
MCP_AUTH=none

# Scopes a token must carry to access the server (comma-separated, optional
# for most modes, REQUIRED for azure).
#MCP_AUTH_REQUIRED_SCOPES=mcp:read,mcp:write

# --- static (development only — fixed bearer tokens) -----------------------
# Comma-separated tokens, or JSON mapping tokens to scopes:
#   MCP_AUTH_STATIC_TOKENS={"dev-token": ["mcp:read"]}
#MCP_AUTH_STATIC_TOKENS=dev-token

# --- jwt (verify JWTs from Keycloak, Okta, Entra ID, Cognito, ...) ----------
#MCP_AUTH_JWKS_URI=https://idp.example.com/.well-known/jwks.json
#MCP_AUTH_PUBLIC_KEY=            # PEM public key, alternative to JWKS URI
#MCP_AUTH_ISSUER=https://idp.example.com/
#MCP_AUTH_AUDIENCE=cisco-sdwan-mcp
#MCP_AUTH_ALGORITHM=             # only needed with MCP_AUTH_PUBLIC_KEY, e.g. RS256

# --- introspection (opaque tokens via RFC 7662) ------------------------------
#MCP_AUTH_INTROSPECTION_URL=https://idp.example.com/oauth/introspect
#MCP_AUTH_CLIENT_ID=mcp-server
#MCP_AUTH_CLIENT_SECRET=change-me

# --- oauth-proxy (full OAuth 2.1 flow via any upstream IdP) ------------------
# Also requires the jwt variables above to verify upstream access tokens.
#MCP_AUTH_UPSTREAM_AUTHORIZATION_ENDPOINT=https://idp.example.com/authorize
#MCP_AUTH_UPSTREAM_TOKEN_ENDPOINT=https://idp.example.com/oauth/token
#MCP_AUTH_CLIENT_ID=client-id
#MCP_AUTH_CLIENT_SECRET=client-secret
#MCP_AUTH_BASE_URL=https://mcp.example.com   # public URL of THIS server

# --- github / google (hosted "login with ..." providers) ---------------------
#MCP_AUTH_CLIENT_ID=...
#MCP_AUTH_CLIENT_SECRET=...
#MCP_AUTH_BASE_URL=https://mcp.example.com

# --- azure (Microsoft Entra ID; MCP_AUTH_REQUIRED_SCOPES is required) --------
#MCP_AUTH_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- auth0 --------------------------------------------------------------------
#MCP_AUTH_AUTH0_CONFIG_URL=https://TENANT.auth0.com/.well-known/openid-configuration
#MCP_AUTH_AUDIENCE=https://mcp.example.com

# --- workos (AuthKit) ---------------------------------------------------------
#MCP_AUTH_AUTHKIT_DOMAIN=https://TENANT.authkit.app
